@inherits LayoutComponentBase

@* Remarks: https://www.fluentui-blazor.net/layout *@
<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header">
        <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12px" Style="padding: 0 16px;">
            <FluentText As="TextTag.Span" Size="TextSize.Size500" Weight="TextWeight.Semibold">Blueprint</FluentText>
            <FluentSpacer />
            <LoginDisplay />
        </FluentStack>
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Navigation" Width="220px">
        <NavMenu />
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Content">
        <main class="content">
            @Body
        </main>
    </FluentLayoutItem>
</FluentLayout>

<FluentProviders />

<div id="blazor-error-ui" data-nosnippet>
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">🗙</span>
</div>
