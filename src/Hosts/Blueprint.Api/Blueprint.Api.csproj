<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Host des modularen Monolithen: setzt die Module zusammen. Ein späterer Microservice ist ein weiterer,
    gleich aufgebauter Host, der nur EIN Modul registriert.
  -->
  <PropertyGroup>
    <UserSecretsId>blueprint-api-7c1e1f8a</UserSecretsId>
    <!--
      OpenAPI-Dokumente (eines pro Modul) werden bei jedem Build nach /openapi geschrieben und eingecheckt.
      Sie sind der Vertrag, aus dem Refitter die Clients erzeugt (CI prüft, dass sie aktuell sind).
      Remarks: https://learn.microsoft.com/aspnet/core/fundamentals/openapi/aspnetcore-openapi#generate-openapi-documents-at-build-time
    -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)../../../openapi</OpenApiDocumentsDirectory>
    <!-- OpenAPI 3.0 für maximale Generator-Kompatibilität (Refitter/NSwag); Dateinamen: <modul>.json -->
    <OpenApiGenerateDocumentsOptions>--openapi-version OpenApi3_0 --file-name blueprint</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Keycloak.Authentication" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Aspire\Blueprint.ServiceDefaults\Blueprint.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\Modules\Catalog\Blueprint.Modules.Catalog.Infrastructure\Blueprint.Modules.Catalog.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Ordering\Blueprint.Modules.Ordering.Infrastructure\Blueprint.Modules.Ordering.Infrastructure.csproj" />
  </ItemGroup>
</Project>
